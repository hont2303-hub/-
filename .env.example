# ============================================================
# note.com 自動投稿システム 環境変数テンプレート
# このファイルを .env としてコピーして値を設定してください
# ============================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=

# --- note.com ログイン情報 ---
NOTE_EMAIL=
NOTE_PASSWORD=

# --- X（Twitter）ログイン情報 ---
X_EMAIL=
X_PASSWORD=
X_USERNAME=

# --- Google アカウント（Gemini画像生成用）---
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# --- 投稿設定 ---
# 1日の最低投稿記事数
ARTICLES_PER_DAY=5
# 投稿時刻（HH:MM形式）
POST_TIME=07:00
# 記事の文字数（目安）
ARTICLE_MIN_CHARS=3000
ARTICLE_MAX_CHARS=5000
# 品質スコアの閾値（0.0〜1.0、これ未満なら再生成）
QUALITY_THRESHOLD=0.7
# 再生成の最大回数
MAX_REGENERATE=2

# --- ブラウザ設定 ---
# headless=true にすると画面なしで実行
BROWSER_HEADLESS=false
# スローモーション（ms）0=最速
BROWSER_SLOW_MO=100
