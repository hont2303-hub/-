# ============================================================
# note.com 自動投稿システム
# ============================================================

# 環境変数・シークレット
.env

# SQLiteデータベース
data/db/*.db
data/*.db

# 生成ファイル（投稿キット・画像・エクスポート）
data/images/
data/exports/
data/reports/

# Playwright認証状態（ログイン情報が含まれるため）
browser/auth_storage/*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# ログ
logs/
*.log

# ============================================================
### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-file
*.flf
#Test results file
TestResults.xml